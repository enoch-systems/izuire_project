# Copy to .env and fill in your own values.

# ── Supabase (frontend-safe: bundled into the app) ──────────────────────
# The anon key is public; the service_role key must stay server-side only.
NG_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NG_SUPABASE_ANON_KEY=your-anon-key

# The one email allowed into /admin, plus the password seed:db gives it.
NG_ADMIN_EMAIL=you@example.com
NG_ADMIN_PASSWORD=ChangeMe123!

# ── Server-side only (used by tools/seed-db.mjs — NEVER bundled) ────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Cloudinary ──────────────────────────────────────────────────────────
# Get these from the Cloudinary console: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional overrides
CLOUDINARY_FOLDER=ders-videos
VIDEO_DIR=C:/path/to/your/videos
